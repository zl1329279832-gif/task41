<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fc.v2.mapper.custom.NoticeDao">

  <!-- 根据角色ID列表查询关联的用户ID -->
  <select id="selectUserIdsByRoleIds" resultType="String">
    SELECT DISTINCT ru.sys_user_id
    FROM t_sys_role_user ru
    WHERE ru.sys_role_id IN
    <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
      #{roleId}
    </foreach>
  </select>

  <!-- 根据部门ID列表查询关联的用户ID -->
  <select id="selectUserIdsByDeptIds" resultType="String">
    SELECT DISTINCT u.id
    FROM t_sys_user u
    WHERE u.dep_id IN
    <foreach collection="deptIds" item="deptId" open="(" separator="," close=")">
      #{deptId}
    </foreach>
  </select>

  <!-- 统计用户未读公告数量（排除已撤回的公告 status=2） -->
  <select id="countUnreadByUserId" resultType="int">
    SELECT COUNT(*)
    FROM t_sys_notice_user nu
    INNER JOIN t_sys_notice n ON nu.notice_id = n.id
    WHERE nu.user_id = #{userId}
      AND nu.state = 0
      AND n.status != 2
  </select>

</mapper>
